#!/usr/bin/env bash
# ==============================================================================
# Mac No-Sleep: 蓋（クラムシェル）を閉じてもスリープさせないCLIツール
# ==============================================================================

set -e

# シンボリックリンクを解決してスクリプトの実体があるディレクトリを取得
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
APP_BIN="${DIR}/nosleep-mac"

# ヘルプ表示
show_help() {
    cat << 'EOF'
  ✦ Mac No-Sleep — 蓋（クラムシェル）閉じスリープ防止ツール

  【概要】
    MacBookのディスプレイ（蓋）を閉じてもスリープさせず、処理を継続します。
    指定した時間が経過すると自動解除され、通常の省電力モードに戻ります。
    Dock、メニューバー、ターミナルで残り時間をリアルタイムに確認・操作できます。

  【使用方法】
    nosleep [時間]
    nosleep [オプション]

  【指定例】
    nosleep            # デフォルト (30分)
    nosleep 15m        # 15分
    nosleep 1h         # 1時間
    nosleep 1.5h       # 1時間30分
    nosleep 90s        # 90秒
    nosleep 45         # 45分 (単位なしは分)

  【オプション】
    -s, --status       現在のスリープ設定（有効/無効）を確認
    -o, --off, --restore スリープ防止を強制解除（通常スリープに復元）
    -h, --help         このヘルプを表示

  【解除方法】
    ・ターミナル: [q] キー または [Ctrl+C]
    ・Dock: アイコンを右クリック →「× スリープ防止を解除して終了」
    ・メニューバー: アイコンをクリック →「× スリープ防止を解除して終了」
    ・別ターミナル: `nosleep --off` を実行

EOF
}

# 現在のステータス確認
check_status() {
    echo "  ○ スリープ設定を確認中..."
    local sleep_status
    sleep_status=$(pmset -g | grep -E "SleepDisabled|sleep\b")
    echo "${sleep_status}"
    
    if pmset -g | grep -qi "SleepDisabled.*1"; then
        echo -e "\n  \033[33m✧ 蓋閉じスリープ防止が【有効】です（Macを閉じてもスリープしません）。\033[0m"
        echo "    解除コマンド: nosleep --off"
    else
        echo -e "\n  \033[32m✓ 通常スリープモードです（Macを閉じると通常通りスリープします）。\033[0m"
    fi
    exit 0
}

# 強制解除
restore_sleep() {
    echo "  ○ スリープ防止を解除し、通常設定に戻します..."
    sudo pmset -a disablesleep 0 sleep 1
    echo -e "  \033[32m✓ スリープ防止を解除しました。Macの蓋を閉じると通常通りスリープします。\033[0m"
    osascript -e 'display notification "スリープ防止を解除しました。通常通りスリープします。" with title "✦ Mac No-Sleep" sound name "Glass"' 2>/dev/null || true
    exit 0
}

# 引数チェック
case "$1" in
    -h|--help)
        show_help
        exit 0
        ;;
    -s|--status)
        check_status
        ;;
    -o|--off|--restore)
        restore_sleep
        ;;
esac

# バイナリが存在しない場合はビルド
if [ ! -f "${APP_BIN}" ]; then
    echo "  ○ 初回ビルドを実行中..."
    swiftc -O -o "${APP_BIN}" "${DIR}/src/main.swift"
    echo "  ✓ ビルドが完了しました。"
fi

# 管理者権限 (sudo) の確認
echo "  ○ 電源設定変更のため、管理者パスワードの入力が必要です:"
if ! sudo -v; then
    echo "  × 認証に失敗しました。終了します。"
    exit 1
fi

# バックグラウンドで sudo 認証を維持
( while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done ) 2>/dev/null &
SUDO_KEEP_PID=$!

# クリーンアップ関数
cleanup() {
    local exit_code=$?
    printf "\033[?25h" 2>/dev/null || true
    
    if [ -n "${CAFFEINATE_PID}" ] && kill -0 "${CAFFEINATE_PID}" 2>/dev/null; then
        kill "${CAFFEINATE_PID}" 2>/dev/null || true
    fi

    if [ -n "${SUDO_KEEP_PID}" ] && kill -0 "${SUDO_KEEP_PID}" 2>/dev/null; then
        kill "${SUDO_KEEP_PID}" 2>/dev/null || true
    fi
    
    sudo pmset -a disablesleep 0 sleep 1 2>/dev/null || true
    exit "${exit_code}"
}
trap cleanup EXIT INT TERM HUP

# 1. システムスリープおよびアイドルスリープを完全無効化
sudo pmset -a disablesleep 1 sleep 0

# 2. caffeinate を二重盾としてバックグラウンド起動 (ディスプレイ・アイドル・システム覚醒を維持)
caffeinate -disu -w $$ &
CAFFEINATE_PID=$!

# 3. メインアプリケーション（Dock ＆ メニューバー ＆ ターミナルUI ＆ カーネルアサーション）を起動
"${APP_BIN}" "$@"
