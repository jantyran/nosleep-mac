#!/usr/bin/env bash
# macOSのスリープ防止セッションを安全に管理するランチャー

set -Eeuo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
APP_BIN="${DIR}/nosleep-mac"
PMSET_BIN="/usr/bin/pmset"

STATE_ROOT="${TMPDIR:-/tmp}/nosleep-mac-${UID}"
STATE_FILE="${STATE_ROOT}/session.env"
LOCK_DIR="${STATE_ROOT}/lock"
PID_FILE="${LOCK_DIR}/pid"

POWER_SETTINGS_CHANGED=0
APP_PID=""
CAFFEINATE_PID=""
SUDO_KEEP_PID=""

show_help() {
    cat <<'EOF'
Usage:
  nosleep [duration]
  nosleep [option]

Examples:
  nosleep          # 30 minutes (default)
  nosleep 15m      # 15 minutes
  nosleep 1h       # 1 hour
  nosleep 1.5h     # 1 hour 30 minutes
  nosleep 90s      # 90 seconds

Options:
  -s, --status          Show the current power settings and session status
  -o, --off, --restore  Stop the active session and restore saved settings
  -h, --help            Show this help
EOF
}

ensure_state_root() {
    if [ -e "$STATE_ROOT" ]; then
        if [ ! -d "$STATE_ROOT" ] || [ ! -O "$STATE_ROOT" ]; then
            echo "Error: unsafe session state path: $STATE_ROOT" >&2
            exit 1
        fi
    else
        (umask 077 && mkdir -p "$STATE_ROOT")
    fi
}

state_value() {
    local key="$1"
    [ -f "$STATE_FILE" ] || return 1
    awk -F= -v key="$key" '$1 == key { print substr($0, length(key) + 2); exit }' "$STATE_FILE"
}

read_pmset_custom_value() {
    local header="$1"
    local key="$2"
    "$PMSET_BIN" -g custom | awk -v header="$header:" -v key="$key" '
        $0 == header { active = 1; next }
        /^[^[:space:]].*:$/{ active = 0 }
        active && $1 == key { print $2; exit }
    '
}

read_sleep_disabled() {
    "$PMSET_BIN" -g | awk '/SleepDisabled/ { print $NF; exit }'
}

save_power_settings() {
    local disabled b_sleep c_sleep u_sleep
    disabled="$(read_sleep_disabled)"
    b_sleep="$(read_pmset_custom_value "Battery Power" sleep)"
    c_sleep="$(read_pmset_custom_value "AC Power" sleep)"
    u_sleep="$(read_pmset_custom_value "UPS Power" sleep)"

    if [ -z "$disabled" ] || { [ -z "$b_sleep" ] && [ -z "$c_sleep" ] && [ -z "$u_sleep" ]; }; then
        echo "Error: could not snapshot the current power settings; no changes were made." >&2
        exit 1
    fi

    (umask 077 && cat >"$STATE_FILE" <<EOF
pid=$$
disablesleep=$disabled
b_sleep=$b_sleep
c_sleep=$c_sleep
u_sleep=$u_sleep
EOF
    )
}

restore_power_settings() {
    local disabled restored=1 profile value
    disabled="$(state_value disablesleep || true)"
    if [ -z "$disabled" ]; then
        echo "Error: saved power settings are incomplete: $STATE_FILE" >&2
        return 1
    fi

    for profile in b c u; do
        value="$(state_value "${profile}_sleep" || true)"
        if [ -n "$value" ] && ! sudo -n "$PMSET_BIN" "-$profile" sleep "$value"; then
            restored=0
        fi
    done
    if ! sudo -n "$PMSET_BIN" -a disablesleep "$disabled"; then
        restored=0
    fi

    if [ "$restored" -ne 1 ]; then
        echo "Error: failed to restore one or more power settings. Saved values remain in $STATE_FILE." >&2
        return 1
    fi
}

clear_session_state() {
    rm -f "$STATE_FILE" "$PID_FILE"
    rmdir "$LOCK_DIR" 2>/dev/null || true
    rmdir "$STATE_ROOT" 2>/dev/null || true
}

acquire_session_lock() {
    ensure_state_root
    if mkdir "$LOCK_DIR" 2>/dev/null; then
        printf '%s\n' "$$" >"$PID_FILE"
        return
    fi

    local active_pid
    active_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$active_pid" ] && kill -0 "$active_pid" 2>/dev/null; then
        echo "Error: nosleep-mac is already running (PID: $active_pid). Use nosleep --off first." >&2
        exit 1
    fi

    echo "Error: stale or invalid nosleep-mac session state found at $STATE_ROOT." >&2
    echo "Run 'nosleep --off' to restore its saved settings before starting a new session." >&2
    exit 1
}

check_status() {
    local active_pid
    active_pid="$(state_value pid || true)"
    "$PMSET_BIN" -g
    if [ -n "$active_pid" ] && kill -0 "$active_pid" 2>/dev/null; then
        echo "\nnosleep-mac session: active (PID: $active_pid)"
    else
        echo "\nnosleep-mac session: inactive"
    fi
}

stop_session() {
    ensure_state_root
    local active_pid
    active_pid="$(state_value pid || true)"

    if [ -n "$active_pid" ] && kill -0 "$active_pid" 2>/dev/null; then
        echo "Stopping nosleep-mac session (PID: $active_pid)..."
        kill -TERM "$active_pid"
        return
    fi

    if [ ! -f "$STATE_FILE" ]; then
        echo "No nosleep-mac session is active."
        return
    fi

    echo "Restoring settings from a stale session..."
    sudo -v
    if restore_power_settings; then
        clear_session_state
        echo "Power settings restored."
    fi
}

cleanup() {
    local exit_code=$?
    trap - EXIT INT TERM HUP
    printf '\033[?25h' 2>/dev/null || true

    if [ -n "$APP_PID" ] && kill -0 "$APP_PID" 2>/dev/null; then
        kill -TERM "$APP_PID" 2>/dev/null || true
    fi
    if [ -n "$CAFFEINATE_PID" ] && kill -0 "$CAFFEINATE_PID" 2>/dev/null; then
        kill "$CAFFEINATE_PID" 2>/dev/null || true
    fi
    if [ -n "$SUDO_KEEP_PID" ] && kill -0 "$SUDO_KEEP_PID" 2>/dev/null; then
        kill "$SUDO_KEEP_PID" 2>/dev/null || true
    fi

    if [ "$POWER_SETTINGS_CHANGED" -eq 1 ]; then
        if restore_power_settings; then
            clear_session_state
        else
            echo "Run 'nosleep --off' after resolving sudo access to restore the saved settings." >&2
        fi
    else
        clear_session_state
    fi
    exit "$exit_code"
}

case "${1:-}" in
    -h|--help)
        show_help
        exit 0
        ;;
    -s|--status)
        check_status
        exit 0
        ;;
    -o|--off|--restore)
        stop_session
        exit 0
        ;;
esac

if [ ! -x "$APP_BIN" ]; then
    echo "Building nosleep-mac..."
    swiftc -O -o "$APP_BIN" "$DIR"/src/*.swift
fi

acquire_session_lock
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

echo "Administrator authentication is required to change power settings."
sudo -v
save_power_settings

(while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done) 2>/dev/null &
SUDO_KEEP_PID=$!

sudo "$PMSET_BIN" -a disablesleep 1 sleep 0
POWER_SETTINGS_CHANGED=1

caffeinate -disu -w "$$" &
CAFFEINATE_PID=$!

"$APP_BIN" "$@" &
APP_PID=$!
wait "$APP_PID"
